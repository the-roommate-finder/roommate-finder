#  Application 
APP_NAME=RoomMate Finder
APP_ENV=development                          # development | staging | production
APP_VERSION=1.0.0
APP_DEBUG=false
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=["localhost","127.0.0.1"]

#  Server 
HOST=0.0.0.0
PORT=8000
WORKERS=4

#  Security 
SECRET_KEY=CHANGE_ME_USE_SECRETS_TOKEN_HEX_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=3
ACCOUNT_LOCKOUT_MINUTES=60

#  CORS 
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

#  Database 
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/roommate_finder
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

#  Redis 
REDIS_URL=redis://localhost:6379/0
REDIS_CELERY_URL=redis://localhost:6379/1
REDIS_CACHE_TTL=3600

#  Email (Resend) 
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=noreply@roommatefinder.com
EMAIL_FROM_NAME=RoomMate Finder

#  Object Storage (S3-compatible) 
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_NAME=roommate-finder-media
S3_REGION=us-east-1
S3_CDN_URL=https://cdn.roommatefinder.com

#  Rate Limiting 
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_OTP_RESEND=2/minute
RATE_LIMIT_API_DEFAULT=100/minute
RATE_LIMIT_LISTING=30/minute
RATE_LIMIT_CHAT=60/minute

#  Celery 
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

#  WebRTC 
TURN_SERVER_URL=turn:turn.roommatefinder.com:3478
TURN_USERNAME=CHANGE_ME
TURN_CREDENTIAL=CHANGE_ME
STUN_SERVER_URL=stun:stun.l.google.com:19302

#  GeoIP 
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb

#  Uploads 
MAX_UPLOAD_SIZE_MB=10
VOICE_NOTE_MAX_DURATION_SECONDS=300
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
ALLOWED_AUDIO_TYPES=["audio/aac","audio/mpeg","audio/ogg"]
THUMBNAIL_SIZE=400,300
